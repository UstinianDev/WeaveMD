{
  // ============================================
  // WeaveMD — Claude 专属 Hooks 配置
  // 编码 → 测试 → 文档 → 提交（强制顺序）
  // ============================================

  // --- 编辑器设置 ---
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.rulers": [100],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit",
    "source.organizeImports": "explicit"
  },
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.autoSave": "onFocusChange",

  // --- TypeScript ---
  "typescript.tsdk": "node_modules/typescript/lib",
  "typescript.enablePromptUseWorkspaceTsdk": true,
  "typescript.preferences.importModuleSpecifier": "relative",
  "typescript.tsserver.experimental.enableProjectDiagnostics": true,

  // --- TailwindCSS ---
  "tailwindCSS.experimental.classRegex": [],
  "tailwindCSS.includeLanguages": {
    "typescript": "javascript",
    "typescriptreact": "javascript"
  },

  // --- 文件排除 ---
  "files.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/.git": true,
    "**/out": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/dist": true,
    "**/out": true,
    "**/package-lock.json": true
  },

  // ============================================
  // 任务 Hooks — 编码 → 测试 → 文档 → 提交
  // Ctrl+Shift+B 构建 / Ctrl+Shift+P "Tasks: Run Task"
  // ============================================

  "tasks": {
    "version": "2.0.0",
    "tasks": [
      // --------------------------------------------------
      // Hook 1: 类型检查
      // --------------------------------------------------
      {
        "label": "🔍 TypeCheck (tsc)",
        "type": "shell",
        "command": "npx tsc --noEmit",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true,
          "focus": false
        },
        "problemMatcher": ["$tsc"]
      },

      // --------------------------------------------------
      // Hook 2: 单元测试
      // --------------------------------------------------
      {
        "label": "🧪 Unit Tests (vitest)",
        "type": "shell",
        "command": "npx vitest run",
        "group": {
          "kind": "test",
          "isDefault": true
        },
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true,
          "focus": false
        },
        "problemMatcher": []
      },

      // --------------------------------------------------
      // Hook 3: ESLint 检查
      // --------------------------------------------------
      {
        "label": "📏 Lint Check (eslint)",
        "type": "shell",
        "command": "npx eslint . --ext .ts,.tsx",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true,
          "focus": false
        },
        "problemMatcher": ["$eslint-stylish"]
      },

      // --------------------------------------------------
      // Hook 4: 完整验证（类型+测试+Lint）
      // --------------------------------------------------
      {
        "label": "✅ Verify All (tsc + vitest + eslint)",
        "type": "shell",
        "command": "npx tsc --noEmit && npx vitest run && npx eslint . --ext .ts,.tsx",
        "group": {
          "kind": "build",
          "isDefault": true
        },
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true,
          "focus": false
        },
        "problemMatcher": ["$tsc", "$eslint-stylish"],
        "dependsOrder": "sequence",
        "dependsOn": []
      },

      // --------------------------------------------------
      // Hook 5: 文档更新提醒
      // --------------------------------------------------
      {
        "label": "📝 Update Documentation",
        "type": "shell",
        "command": "echo '⚠️  REMINDER: Update docs/ files before committing. See .claude/rules/WORKFLOW.md for guidance.'",
        "group": "none",
        "presentation": {
          "reveal": "silent",
          "panel": "shared",
          "clear": false,
          "focus": false
        }
      },

      // --------------------------------------------------
      // Hook 6: Git 提交 + 推送
      // --------------------------------------------------
      {
        "label": "🚀 Git Commit & Push",
        "type": "shell",
        "command": "git add -A && git commit -m \"${input:commitMessage}\" && git push",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true,
          "focus": false
        },
        "problemMatcher": []
      },

      // --------------------------------------------------
      // Hook 7: 一键完整工作流
      // Verify All → 文档提醒 → 等待确认 → 提交推送
      // --------------------------------------------------
      {
        "label": "🎯 Full Workflow (Verify → Doc → Commit)",
        "dependsOrder": "sequence",
        "dependsOn": [
          "✅ Verify All (tsc + vitest + eslint)",
          "📝 Update Documentation",
          "🚀 Git Commit & Push"
        ],
        "group": {
          "kind": "build",
          "isDefault": false
        },
        "presentation": {
          "reveal": "always",
          "panel": "new",
          "clear": true,
          "focus": false
        },
        "problemMatcher": []
      },

      // --------------------------------------------------
      // Hook 8: 启动开发服务器
      // --------------------------------------------------
      {
        "label": "🖥️ Start Dev Server",
        "type": "shell",
        "command": "npm run dev",
        "group": "none",
        "isBackground": true,
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true,
          "focus": false
        },
        "problemMatcher": []
      },

      // --------------------------------------------------
      // Hook 9: 生产构建
      // --------------------------------------------------
      {
        "label": "📦 Production Build",
        "type": "shell",
        "command": "npm run build",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true,
          "focus": false
        },
        "problemMatcher": []
      },

      // --------------------------------------------------
      // Hook 10: 数据库迁移
      // --------------------------------------------------
      {
        "label": "🗄️ Run DB Migrations",
        "type": "shell",
        "command": "npm run db:migrate",
        "group": "none",
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true,
          "focus": false
        },
        "problemMatcher": []
      },

      // --------------------------------------------------
      // Hook 11: 仅运行变更文件相关的测试（快速验证）
      // --------------------------------------------------
      {
        "label": "⚡ Quick Test (related files)",
        "type": "shell",
        "command": "npx vitest run --changed",
        "group": {
          "kind": "test",
          "isDefault": false
        },
        "presentation": {
          "reveal": "always",
          "panel": "dedicated",
          "clear": true,
          "focus": false
        },
        "problemMatcher": []
      }
    ],

    // --------------------------------------------------
    // 输入变量
    // --------------------------------------------------
    "inputs": [
      {
        "id": "commitMessage",
        "type": "promptString",
        "description": "Git commit message — format: type(scope): message (e.g. feat(editor): add syntax highlighting)",
        "default": "feat: "
      }
    ]
  }
}
