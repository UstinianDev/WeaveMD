{
  // ============================================
  // WeaveMD — Claude Code 专属 Hooks
  // 编码 → 测试 → 文档 → 提交（自动触发）
  // ============================================

  "hooks": {
    // --------------------------------------------------
    // Hook: 文件写入后自动格式化+Lint 修复
    // 每次 Write/Edit 后对 TS/TSX 文件运行 ESLint
    // --------------------------------------------------
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path // .tool_response.filePath // empty' 2>/dev/null | while IFS= read -r f; do case \"$f\" in *.ts|*.tsx|*.js|*.jsx) npx eslint \"$f\" --fix 2>/dev/null; npx prettier --write \"$f\" 2>/dev/null ;; esac; done || true",
            "timeout": 30,
            "statusMessage": "Fixing lint & format..."
          }
        ]
      }
    ],

    // --------------------------------------------------
    // Hook: 会话开始时提醒工作流
    // --------------------------------------------------
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"📋 开发工作流: 编码 → 测试(npm test) → 类型检查(npm run typecheck) → 文档 → 提交。Ctrl+Shift+B 一键验证。\"}' 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],

    // --------------------------------------------------
    // Hook: Stop 时提醒验证
    // --------------------------------------------------
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"systemMessage\": \"💡 别忘了执行完整验证: npm run test && npm run typecheck && npm run lint\"}' 2>/dev/null || true",
            "timeout": 5
          }
        ]
      }
    ],

    // --------------------------------------------------
    // Hook: Git 提交前自动验证提醒
    // --------------------------------------------------
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.command // \"\"' 2>/dev/null | grep -qE 'git (commit|push)' && echo '{\"systemMessage\": \"⚠️  提交前请先运行验证: npm run test && npm run typecheck && npm run lint\"}' || true",
            "timeout": 5
          }
        ]
      }
    ]
  },

  // ============================================
  // 权限配置 — 减少不必要的提示
  // ============================================
  "permissions": {
    "allow": [
      "Bash(npm *)",
      "Bash(npx *)",
      "Bash(git *)",
      "Bash(node *)",
      "Bash(ls *)",
      "Bash(dir *)",
      "Bash(cd *)",
      "Bash(pwd)",
      "Bash(echo *)",
      "Bash(mkdir *)",
      "Bash(jq *)",
      "Bash(grep *)",
      "Edit(.claude/*)",
      "Edit(.vscode/*)",
      "Read",
      "Glob",
      "Grep"
    ],
    "deny": [
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Write(/etc/*)",
      "Write(/System/*)"
    ]
  },

  // ============================================
  // 项目环境变量
  // ============================================
  "env": {
    "NODE_ENV": "development"
  }
}
